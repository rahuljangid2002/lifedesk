rules_version = '2';
// LifeDesk: each signed-in user can read and write only their own data, everything under users/{their id}/...
// Every tool (Money, reminders, ...) keeps its collections there, so new tools need no rule change.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
